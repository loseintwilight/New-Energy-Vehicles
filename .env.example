# ============================================
# NEV 项目 Docker Compose 环境变量示例
# 复制为 .env 并修改为实际值，切勿提交 .env 到仓库
# ============================================

# MySQL
MYSQL_ROOT_PASSWORD=change-me-to-a-strong-password

# MinIO（长度至少8位）
MINIO_ACCESS_KEY=your-access-key
MINIO_SECRET_KEY=your-secret-key
