<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.newcar.mapper.NewCarMapper">

    <resultMap id="NewCarResult" type="com.ruoyi.newcar.domain.NewCar">
        <id     property="vehicleId"    column="vehicle_id"    />
        <result property="vehicleType"  column="vehicle_type"  />
        <result property="modelName"    column="model_name"    />
        <result property="title"        column="title"         />
        <result property="guidePrice"   column="guide_price"   />
        <result property="originalPrice" column="original_price" />
        <result property="color"        column="color"         />
        <result property="stock"        column="stock"         />
        <result property="merchantId"   column="merchant_id"   />
        <result property="description"  column="description"   />
        <result property="tags"         column="tags"          />
        <result property="viewCount"    column="view_count"    />
        <result property="status"       column="status"        />
        <result property="publishTime"  column="publish_time"  />
        <result property="createTime"   column="create_time"   />
        <result property="updateTime"   column="update_time"   />
    </resultMap>

    <select id="selectCarList" parameterType="com.ruoyi.newcar.domain.NewCar" resultMap="NewCarResult">
        select * from stad_vehicle
        where vehicle_type = 'new' and status = '1'
        <if test="modelName != null and modelName != ''">
            and model_name like concat('%', #{modelName}, '%')
        </if>
        <if test="vehicleId != null">
            and vehicle_id = #{vehicleId}
        </if>
    </select>

    <select id="selectCarById" parameterType="Long" resultMap="NewCarResult">
        select * from stad_vehicle where vehicle_id = #{vehicleId}
    </select>

    <select id="selectUsedCars" resultMap="NewCarResult">
        select * from stad_vehicle where vehicle_type = 'used' and status = '1'
    </select>

</mapper>