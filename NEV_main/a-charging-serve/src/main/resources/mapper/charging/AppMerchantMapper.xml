<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.charging.mapper.AppMerchantMapper">
    
    <resultMap type="com.ruoyi.charging.domain.AppMerchant" id="AppMerchantResult">
        <id property="merchantId" column="merchant_id"/>
        <result property="userId" column="user_id"/>
        <result property="merchantName" column="merchant_name"/>
        <result property="merchantType" column="merchant_type"/>
        <result property="contactName" column="contact_name"/>
        <result property="contactPhone" column="contact_phone"/>
        <result property="province" column="province"/>
        <result property="city" column="city"/>
        <result property="address" column="address"/>
        <result property="openTime" column="open_time"/>
        <result property="closeTime" column="close_time"/>
        <result property="businessLicense" column="business_license"/>
        <result property="legalPerson" column="legal_person"/>
        <result property="idCard" column="id_card"/>
        <result property="status" column="status"/>
        <result property="auditRemark" column="audit_remark"/>
        <result property="auditTime" column="audit_time"/>
        <result property="totalIncome" column="total_income"/>
        <result property="settledAmount" column="settled_amount"/>
        <result property="pendingAmount" column="pending_amount"/>
        <result property="withdrawnAmount" column="withdrawn_amount"/>
        <result property="bankName" column="bank_name"/>
        <result property="bankAccount" column="bank_account"/>
        <result property="createTime" column="create_time"/>
        <result property="updateTime" column="update_time"/>
    </resultMap>

    <sql id="selectAppMerchantVo">
        select merchant_id, user_id, merchant_name, merchant_type, contact_name, contact_phone,
               province, city, address, open_time, close_time, business_license, legal_person,
               id_card, status, audit_remark, audit_time, total_income, settled_amount,
               pending_amount, withdrawn_amount, bank_name, bank_account,
               create_time, update_time
        from stad_merchant
    </sql>

    <select id="selectAppMerchantById" parameterType="Long" resultMap="AppMerchantResult">
        <include refid="selectAppMerchantVo"/>
        where merchant_id = #{merchantId}
    </select>

    <select id="selectAppMerchantByUserId" parameterType="Long" resultMap="AppMerchantResult">
        <include refid="selectAppMerchantVo"/>
        where user_id = #{userId}
    </select>

    <select id="selectAppMerchantList" parameterType="com.ruoyi.charging.domain.AppMerchant" resultMap="AppMerchantResult">
        <include refid="selectAppMerchantVo"/>
        <where>
            <if test="merchantName != null and merchantName != ''">and merchant_name like concat('%', #{merchantName}, '%')</if>
            <if test="merchantType != null and merchantType != ''">and merchant_type = #{merchantType}</if>
            <if test="status != null and status != ''">and status = #{status}</if>
            <if test="userId != null">and user_id = #{userId}</if>
        </where>
    </select>

    <insert id="insertAppMerchant" parameterType="com.ruoyi.charging.domain.AppMerchant" useGeneratedKeys="true" keyProperty="merchantId">
        insert into stad_merchant
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="userId != null">user_id,</if>
            <if test="merchantName != null">merchant_name,</if>
            <if test="merchantType != null">merchant_type,</if>
            <if test="contactName != null">contact_name,</if>
            <if test="contactPhone != null">contact_phone,</if>
            <if test="province != null">province,</if>
            <if test="city != null">city,</if>
            <if test="address != null">address,</if>
            <if test="openTime != null">open_time,</if>
            <if test="closeTime != null">close_time,</if>
            <if test="businessLicense != null">business_license,</if>
            <if test="legalPerson != null">legal_person,</if>
            <if test="idCard != null">id_card,</if>
            <if test="status != null">status,</if>
            <if test="auditRemark != null">audit_remark,</if>
            <if test="auditTime != null">audit_time,</if>
            <if test="totalIncome != null">total_income,</if>
            <if test="settledAmount != null">settled_amount,</if>
            <if test="pendingAmount != null">pending_amount,</if>
            <if test="withdrawnAmount != null">withdrawn_amount,</if>
            <if test="bankName != null">bank_name,</if>
            <if test="bankAccount != null">bank_account,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null">remark,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="userId != null">#{userId},</if>
            <if test="merchantName != null">#{merchantName},</if>
            <if test="merchantType != null">#{merchantType},</if>
            <if test="contactName != null">#{contactName},</if>
            <if test="contactPhone != null">#{contactPhone},</if>
            <if test="province != null">#{province},</if>
            <if test="city != null">#{city},</if>
            <if test="address != null">#{address},</if>
            <if test="openTime != null">#{openTime},</if>
            <if test="closeTime != null">#{closeTime},</if>
            <if test="businessLicense != null">#{businessLicense},</if>
            <if test="legalPerson != null">#{legalPerson},</if>
            <if test="idCard != null">#{idCard},</if>
            <if test="status != null">#{status},</if>
            <if test="auditRemark != null">#{auditRemark},</if>
            <if test="auditTime != null">#{auditTime},</if>
            <if test="totalIncome != null">#{totalIncome},</if>
            <if test="settledAmount != null">#{settledAmount},</if>
            <if test="pendingAmount != null">#{pendingAmount},</if>
            <if test="withdrawnAmount != null">#{withdrawnAmount},</if>
            <if test="bankName != null">#{bankName},</if>
            <if test="bankAccount != null">#{bankAccount},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
        </trim>
    </insert>

    <update id="updateAppMerchant" parameterType="com.ruoyi.charging.domain.AppMerchant">
        update stad_merchant
        <trim prefix="SET" suffixOverrides=",">
            <if test="merchantName != null">merchant_name = #{merchantName},</if>
            <if test="merchantType != null">merchant_type = #{merchantType},</if>
            <if test="contactName != null">contact_name = #{contactName},</if>
            <if test="contactPhone != null">contact_phone = #{contactPhone},</if>
            <if test="province != null">province = #{province},</if>
            <if test="city != null">city = #{city},</if>
            <if test="address != null">address = #{address},</if>
            <if test="openTime != null">open_time = #{openTime},</if>
            <if test="closeTime != null">close_time = #{closeTime},</if>
            <if test="businessLicense != null">business_license = #{businessLicense},</if>
            <if test="legalPerson != null">legal_person = #{legalPerson},</if>
            <if test="idCard != null">id_card = #{idCard},</if>
            <if test="status != null">status = #{status},</if>
            <if test="auditRemark != null">audit_remark = #{auditRemark},</if>
            <if test="auditTime != null">audit_time = #{auditTime},</if>
            <if test="totalIncome != null">total_income = #{totalIncome},</if>
            <if test="settledAmount != null">settled_amount = #{settledAmount},</if>
            <if test="pendingAmount != null">pending_amount = #{pendingAmount},</if>
            <if test="withdrawnAmount != null">withdrawn_amount = #{withdrawnAmount},</if>
            <if test="bankName != null">bank_name = #{bankName},</if>
            <if test="bankAccount != null">bank_account = #{bankAccount},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where merchant_id = #{merchantId}
    </update>

    <delete id="deleteAppMerchantById" parameterType="Long">
        delete from stad_merchant where merchant_id = #{merchantId}
    </delete>
</mapper>