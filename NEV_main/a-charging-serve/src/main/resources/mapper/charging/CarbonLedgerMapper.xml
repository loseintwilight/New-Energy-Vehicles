<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.charging.mapper.CarbonLedgerMapper">

    <resultMap type="com.ruoyi.charging.domain.CarbonLedger" id="CarbonLedgerResult">
        <id     property="ledgerId"      column="ledger_id"       />
        <result property="userId"        column="user_id"         />
        <result property="recordType"    column="record_type"     />
        <result property="ruleId"        column="rule_id"         />
        <result property="points"        column="points"          />
        <result property="balanceAfter"  column="balance_after"   />
        <result property="sourceType"    column="source_type"     />
        <result property="sourceId"      column="source_id"       />
        <result property="remark"        column="remark"          />
        <result property="createTime"    column="create_time"     />
    </resultMap>

    <sql id="selectLedgerVo">
        select ledger_id, user_id, record_type, rule_id, points,
               balance_after, source_type, source_id, remark, create_time
        from stad_carbon_ledger
    </sql>

    <select id="selectList" parameterType="com.ruoyi.charging.domain.CarbonLedger" resultMap="CarbonLedgerResult">
        <include refid="selectLedgerVo"/>
        <where>
            <if test="userId != null">
                AND user_id = #{userId}
            </if>
            <if test="recordType != null">
                AND record_type = #{recordType}
            </if>
            <if test="sourceType != null">
                AND source_type = #{sourceType}
            </if>
            <if test="params.beginTime != null and params.beginTime != ''">
                and date_format(create_time,'%Y%m%d') &gt;= date_format(#{params.beginTime},'%Y%m%d')
            </if>
            <if test="params.endTime != null and params.endTime != ''">
                and date_format(create_time,'%Y%m%d') &lt;= date_format(#{params.endTime},'%Y%m%d')
            </if>
        </where>
        order by create_time desc
    </select>

    <select id="selectById" parameterType="Long" resultMap="CarbonLedgerResult">
        <include refid="selectLedgerVo"/>
        where ledger_id = #{ledgerId}
    </select>

    <insert id="insert" parameterType="com.ruoyi.charging.domain.CarbonLedger">
        insert into stad_carbon_ledger (
            <if test="userId != null">user_id,</if>
            <if test="recordType != null">record_type,</if>
            <if test="ruleId != null">rule_id,</if>
            <if test="points != null">points,</if>
            <if test="balanceAfter != null">balance_after,</if>
            <if test="sourceType != null">source_type,</if>
            <if test="sourceId != null">source_id,</if>
            <if test="remark != null and remark != ''">remark,</if>
            create_time
        ) values (
            <if test="userId != null">#{userId},</if>
            <if test="recordType != null">#{recordType},</if>
            <if test="ruleId != null">#{ruleId},</if>
            <if test="points != null">#{points},</if>
            <if test="balanceAfter != null">#{balanceAfter},</if>
            <if test="sourceType != null">#{sourceType},</if>
            <if test="sourceId != null">#{sourceId},</if>
            <if test="remark != null and remark != ''">#{remark},</if>
            sysdate()
        )
    </insert>

    <update id="update" parameterType="com.ruoyi.charging.domain.CarbonLedger">
        update stad_carbon_ledger
        <set>
            <if test="userId != null">user_id = #{userId},</if>
            <if test="recordType != null">record_type = #{recordType},</if>
            <if test="ruleId != null">rule_id = #{ruleId},</if>
            <if test="points != null">points = #{points},</if>
            <if test="balanceAfter != null">balance_after = #{balanceAfter},</if>
            <if test="sourceType != null">source_type = #{sourceType},</if>
            <if test="sourceId != null">source_id = #{sourceId},</if>
            <if test="remark != null and remark != ''">remark = #{remark},</if>
        </set>
        where ledger_id = #{ledgerId}
    </update>

    <delete id="deleteByIds" parameterType="String">
        delete from stad_carbon_ledger where ledger_id in
        <foreach item="ledgerId" collection="array" open="(" separator="," close=")">
            #{ledgerId}
        </foreach>
    </delete>

</mapper>
