<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.charging.mapper.ChargingCustomerMapper">

    <resultMap type="com.ruoyi.charging.domain.ChargingCustomer" id="ChargingCustomerResult">
        <id property="customerId" column="customer_id"/>
        <result property="customerName" column="customer_name"/>
        <result property="phone" column="phone"/>
        <result property="carModel" column="car_model"/>
        <result property="carPlate" column="car_plate"/>
        <result property="level" column="level"/>
        <result property="totalAmount" column="total_amount"/>
        <result property="orderCount" column="order_count"/>
        <result property="merchantId" column="merchant_id"/>
        <result property="remark" column="remark"/>
        <result property="status" column="status"/>
        <result property="createTime" column="create_time"/>
        <result property="updateTime" column="update_time"/>
    </resultMap>

    <sql id="selectChargingCustomerVo">
        select customer_id, customer_name, phone, car_model, car_plate, level, total_amount,
               order_count, merchant_id, remark, status, create_time, update_time
        from stad_charging_customer
    </sql>

    <select id="selectChargingCustomerById" parameterType="Long" resultMap="ChargingCustomerResult">
        <include refid="selectChargingCustomerVo"/>
        where customer_id = #{customerId}
    </select>

    <select id="selectChargingCustomerList" parameterType="com.ruoyi.charging.domain.ChargingCustomer" resultMap="ChargingCustomerResult">
        <include refid="selectChargingCustomerVo"/>
        <where>
            <if test="merchantId != null">and merchant_id = #{merchantId}</if>
            <if test="customerName != null and customerName != ''">and customer_name like concat('%', #{customerName}, '%')</if>
            <if test="phone != null and phone != ''">and phone like concat('%', #{phone}, '%')</if>
            <if test="carPlate != null and carPlate != ''">and car_plate like concat('%', #{carPlate}, '%')</if>
            <if test="level != null and level != ''">and level = #{level}</if>
            <if test="status != null and status != ''">and status = #{status}</if>
        </where>
        order by create_time desc
    </select>

    <insert id="insertChargingCustomer" parameterType="com.ruoyi.charging.domain.ChargingCustomer" useGeneratedKeys="true" keyProperty="customerId">
        insert into stad_charging_customer
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="customerName != null">customer_name,</if>
            <if test="phone != null">phone,</if>
            <if test="carModel != null">car_model,</if>
            <if test="carPlate != null">car_plate,</if>
            <if test="level != null">level,</if>
            <if test="totalAmount != null">total_amount,</if>
            <if test="orderCount != null">order_count,</if>
            <if test="merchantId != null">merchant_id,</if>
            <if test="remark != null">remark,</if>
            <if test="status != null">status,</if>
            <if test="createTime != null">create_time,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="customerName != null">#{customerName},</if>
            <if test="phone != null">#{phone},</if>
            <if test="carModel != null">#{carModel},</if>
            <if test="carPlate != null">#{carPlate},</if>
            <if test="level != null">#{level},</if>
            <if test="totalAmount != null">#{totalAmount},</if>
            <if test="orderCount != null">#{orderCount},</if>
            <if test="merchantId != null">#{merchantId},</if>
            <if test="remark != null">#{remark},</if>
            <if test="status != null">#{status},</if>
            <if test="createTime != null">#{createTime},</if>
        </trim>
    </insert>

    <update id="updateChargingCustomer" parameterType="com.ruoyi.charging.domain.ChargingCustomer">
        update stad_charging_customer
        <trim prefix="SET" suffixOverrides=",">
            <if test="customerName != null">customer_name = #{customerName},</if>
            <if test="phone != null">phone = #{phone},</if>
            <if test="carModel != null">car_model = #{carModel},</if>
            <if test="carPlate != null">car_plate = #{carPlate},</if>
            <if test="level != null">level = #{level},</if>
            <if test="totalAmount != null">total_amount = #{totalAmount},</if>
            <if test="orderCount != null">order_count = #{orderCount},</if>
            <if test="merchantId != null">merchant_id = #{merchantId},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="status != null">status = #{status},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </trim>
        where customer_id = #{customerId}
    </update>

    <delete id="deleteChargingCustomerById" parameterType="Long">
        delete from stad_charging_customer where customer_id = #{customerId}
    </delete>
</mapper>