<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.charging.mapper.ChargingRatePeriodMapper">
    
    <resultMap type="com.ruoyi.charging.domain.ChargingRatePeriod" id="ChargingRatePeriodResult">
        <id property="periodId" column="period_id"/>
        <result property="rateId" column="rate_id"/>
        <result property="periodName" column="period_name"/>
        <result property="startTime" column="start_time"/>
        <result property="endTime" column="end_time"/>
        <result property="energyPrice" column="energy_price"/>
        <result property="serviceFee" column="service_fee"/>
        <result property="totalPrice" column="total_price"/>
        <result property="priceType" column="price_type"/>
        <result property="discountRate" column="discount_rate"/>
        <result property="sortOrder" column="sort_order"/>
        <result property="createBy" column="create_by"/>
        <result property="createTime" column="create_time"/>
        <result property="updateBy" column="update_by"/>
        <result property="updateTime" column="update_time"/>
        <result property="remark" column="remark"/>
    </resultMap>

    <sql id="selectChargingRatePeriodVo">
        select period_id, rate_id, period_name, start_time, end_time, energy_price, service_fee,
               total_price, price_type, discount_rate, sort_order,
               create_time, update_time
        from stad_charging_rate_period
    </sql>

    <select id="selectChargingRatePeriodById" parameterType="Long" resultMap="ChargingRatePeriodResult">
        <include refid="selectChargingRatePeriodVo"/>
        where period_id = #{periodId}
    </select>

    <select id="selectChargingRatePeriodListByRateId" parameterType="Long" resultMap="ChargingRatePeriodResult">
        <include refid="selectChargingRatePeriodVo"/>
        where rate_id = #{rateId}
        order by sort_order asc
    </select>

    <select id="selectChargingRatePeriodList" parameterType="com.ruoyi.charging.domain.ChargingRatePeriod" resultMap="ChargingRatePeriodResult">
        <include refid="selectChargingRatePeriodVo"/>
        <where>
            <if test="rateId != null">and rate_id = #{rateId}</if>
            <if test="priceType != null and priceType != ''">and price_type = #{priceType}</if>
        </where>
        order by sort_order asc
    </select>

    <insert id="insertChargingRatePeriod" parameterType="com.ruoyi.charging.domain.ChargingRatePeriod" useGeneratedKeys="true" keyProperty="periodId">
        insert into stad_charging_rate_period
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="rateId != null">rate_id,</if>
            <if test="periodName != null">period_name,</if>
            <if test="startTime != null">start_time,</if>
            <if test="endTime != null">end_time,</if>
            <if test="energyPrice != null">energy_price,</if>
            <if test="serviceFee != null">service_fee,</if>
            <if test="totalPrice != null">total_price,</if>
            <if test="priceType != null">price_type,</if>
            <if test="discountRate != null">discount_rate,</if>
            <if test="sortOrder != null">sort_order,</if>
            <if test="createTime != null">create_time,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="rateId != null">#{rateId},</if>
            <if test="periodName != null">#{periodName},</if>
            <if test="startTime != null">#{startTime},</if>
            <if test="endTime != null">#{endTime},</if>
            <if test="energyPrice != null">#{energyPrice},</if>
            <if test="serviceFee != null">#{serviceFee},</if>
            <if test="totalPrice != null">#{totalPrice},</if>
            <if test="priceType != null">#{priceType},</if>
            <if test="discountRate != null">#{discountRate},</if>
            <if test="sortOrder != null">#{sortOrder},</if>
            <if test="createTime != null">#{createTime},</if>
        </trim>
    </insert>

    <update id="updateChargingRatePeriod" parameterType="com.ruoyi.charging.domain.ChargingRatePeriod">
        update stad_charging_rate_period
        <trim prefix="SET" suffixOverrides=",">
            <if test="periodName != null">period_name = #{periodName},</if>
            <if test="startTime != null">start_time = #{startTime},</if>
            <if test="endTime != null">end_time = #{endTime},</if>
            <if test="energyPrice != null">energy_price = #{energyPrice},</if>
            <if test="serviceFee != null">service_fee = #{serviceFee},</if>
            <if test="totalPrice != null">total_price = #{totalPrice},</if>
            <if test="priceType != null">price_type = #{priceType},</if>
            <if test="discountRate != null">discount_rate = #{discountRate},</if>
            <if test="sortOrder != null">sort_order = #{sortOrder},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </trim>
        where period_id = #{periodId}
    </update>

    <delete id="deleteChargingRatePeriodById" parameterType="Long">
        delete from stad_charging_rate_period where period_id = #{periodId}
    </delete>

    <delete id="deleteChargingRatePeriodByRateId" parameterType="Long">
        delete from stad_charging_rate_period where rate_id = #{rateId}
    </delete>
</mapper>