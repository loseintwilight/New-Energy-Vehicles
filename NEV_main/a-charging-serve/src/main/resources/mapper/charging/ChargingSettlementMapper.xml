<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.charging.mapper.ChargingSettlementMapper">
    
    <resultMap type="com.ruoyi.charging.domain.ChargingSettlement" id="ChargingSettlementResult">
        <id property="settlementId" column="settlement_id"/>
        <result property="merchantId" column="merchant_id"/>
        <result property="settleDate" column="settle_date"/>
        <result property="totalOrders" column="total_orders"/>
        <result property="totalEnergy" column="total_energy"/>
        <result property="totalAmount" column="total_amount"/>
        <result property="platformCommission" column="platform_commission"/>
        <result property="settleAmount" column="settle_amount"/>
        <result property="status" column="status"/>
        <result property="settleTime" column="settle_time"/>
        <result property="withdrawNo" column="withdraw_no"/>
        <result property="withdrawAmount" column="withdraw_amount"/>
        <result property="withdrawStatus" column="withdraw_status"/>
        <result property="withdrawTime" column="withdraw_time"/>
        <result property="createTime" column="create_time"/>
        <result property="updateTime" column="update_time"/>
    </resultMap>

    <sql id="selectChargingSettlementVo">
        select settlement_id, merchant_id, settle_date, total_orders, total_energy, total_amount,
               platform_commission, settle_amount, status, settle_time, withdraw_no, withdraw_amount,
               withdraw_status, withdraw_time, create_time, update_time
        from stad_charging_settlement
    </sql>

    <select id="selectChargingSettlementById" parameterType="Long" resultMap="ChargingSettlementResult">
        <include refid="selectChargingSettlementVo"/>
        where settlement_id = #{settlementId}
    </select>

    <select id="selectChargingSettlementListByMerchantId" parameterType="Long" resultMap="ChargingSettlementResult">
        <include refid="selectChargingSettlementVo"/>
        where merchant_id = #{merchantId}
        order by settle_date desc
    </select>

    <select id="selectChargingSettlementList" parameterType="com.ruoyi.charging.domain.ChargingSettlement" resultMap="ChargingSettlementResult">
        <include refid="selectChargingSettlementVo"/>
        <where>
            <if test="merchantId != null">and merchant_id = #{merchantId}</if>
            <if test="status != null and status != ''">and status = #{status}</if>
            <if test="withdrawStatus != null and withdrawStatus != ''">and withdraw_status = #{withdrawStatus}</if>
            <if test="settleDate != null">and settle_date = #{settleDate}</if>
        </where>
        order by settle_date desc
    </select>

    <insert id="insertChargingSettlement" parameterType="com.ruoyi.charging.domain.ChargingSettlement" useGeneratedKeys="true" keyProperty="settlementId">
        insert into stad_charging_settlement
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="merchantId != null">merchant_id,</if>
            <if test="settleDate != null">settle_date,</if>
            <if test="totalOrders != null">total_orders,</if>
            <if test="totalEnergy != null">total_energy,</if>
            <if test="totalAmount != null">total_amount,</if>
            <if test="platformCommission != null">platform_commission,</if>
            <if test="settleAmount != null">settle_amount,</if>
            <if test="status != null">status,</if>
            <if test="createTime != null">create_time,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="merchantId != null">#{merchantId},</if>
            <if test="settleDate != null">#{settleDate},</if>
            <if test="totalOrders != null">#{totalOrders},</if>
            <if test="totalEnergy != null">#{totalEnergy},</if>
            <if test="totalAmount != null">#{totalAmount},</if>
            <if test="platformCommission != null">#{platformCommission},</if>
            <if test="settleAmount != null">#{settleAmount},</if>
            <if test="status != null">#{status},</if>
            <if test="createTime != null">#{createTime},</if>
        </trim>
    </insert>

    <update id="updateChargingSettlement" parameterType="com.ruoyi.charging.domain.ChargingSettlement">
        update stad_charging_settlement
        <trim prefix="SET" suffixOverrides=",">
            <if test="totalOrders != null">total_orders = #{totalOrders},</if>
            <if test="totalEnergy != null">total_energy = #{totalEnergy},</if>
            <if test="totalAmount != null">total_amount = #{totalAmount},</if>
            <if test="platformCommission != null">platform_commission = #{platformCommission},</if>
            <if test="settleAmount != null">settle_amount = #{settleAmount},</if>
            <if test="status != null">status = #{status},</if>
            <if test="settleTime != null">settle_time = #{settleTime},</if>
            <if test="withdrawNo != null">withdraw_no = #{withdrawNo},</if>
            <if test="withdrawAmount != null">withdraw_amount = #{withdrawAmount},</if>
            <if test="withdrawStatus != null">withdraw_status = #{withdrawStatus},</if>
            <if test="withdrawTime != null">withdraw_time = #{withdrawTime},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </trim>
        where settlement_id = #{settlementId}
    </update>

    <delete id="deleteChargingSettlementById" parameterType="Long">
        delete from stad_charging_settlement where settlement_id = #{settlementId}
    </delete>
</mapper>