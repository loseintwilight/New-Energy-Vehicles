<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.mine.mapper.StadUnifiedOrderMapper">

    <resultMap type="com.ruoyi.mine.domain.MineStadUnifiedOrder" id="StadUnifiedOrderResult">
        <result property="orderId"        column="order_id"        />
        <result property="orderNo"        column="order_no"        />
        <result property="orderType"      column="order_type"      />
        <result property="userId"         column="user_id"         />
        <result property="vehicleId"      column="vehicle_id"      />
        <result property="merchantId"     column="merchant_id"     />
        <result property="contactName"    column="contact_name"    />
        <result property="contactPhone"   column="contact_phone"   />
        <result property="addressId"      column="address_id"      />
        <result property="vehiclePrice"   column="vehicle_price"   />
        <result property="totalAmount"    column="total_amount"    />
        <result property="paidAmount"     column="paid_amount"     />
        <result property="paymentMethod"  column="payment_method"  />
        <result property="insuranceInfo"  column="insurance_info"  />
        <result property="expectDate"     column="expect_date"     />
        <result property="expectTimeSlot" column="expect_time_slot" />
        <result property="oldVehicleId"   column="old_vehicle_id"  />
        <result property="oldValuation"   column="old_valuation"   />
        <result property="newOrderId"     column="new_order_id"    />
        <result property="status"         column="status"          />
        <result property="cancelReason"   column="cancel_reason"   />
        <result property="createTime"     column="create_time"     />
        <result property="updateTime"     column="update_time"     />
        <result property="merchantName"   column="merchant_name"   />
        <result property="nickName"       column="nick_name"       />
    </resultMap>

    <sql id="selectOrderVo">
        select o.order_id, o.order_no, o.order_type, o.user_id, o.vehicle_id,
               o.merchant_id, o.contact_name, o.contact_phone, o.address_id,
               o.vehicle_price, o.total_amount, o.paid_amount, o.payment_method,
               o.insurance_info, o.expect_date, o.expect_time_slot,
               o.old_vehicle_id, o.old_valuation, o.new_order_id,
               o.status, o.cancel_reason, o.create_time, o.update_time,
               m.merchant_name, u.nick_name
        from stad_unified_order o
        left join stad_merchant m on o.merchant_id = m.merchant_id
        left join sys_user u on o.user_id = u.user_id
    </sql>

    <select id="selectStadUnifiedOrderById" parameterType="Long" resultMap="StadUnifiedOrderResult">
        <include refid="selectOrderVo"/>
        where o.order_id = #{orderId}
    </select>

    <select id="selectStadUnifiedOrderList" parameterType="com.ruoyi.mine.domain.MineStadUnifiedOrder" resultMap="StadUnifiedOrderResult">
        <include refid="selectOrderVo"/>
        <where>
            <if test="orderNo != null and orderNo != ''">
                AND o.order_no like concat('%', #{orderNo}, '%')
            </if>
            <if test="orderType != null and orderType != ''">
                AND o.order_type = #{orderType}
            </if>
            <if test="userId != null">
                AND o.user_id = #{userId}
            </if>
            <if test="vehicleId != null">
                AND o.vehicle_id = #{vehicleId}
            </if>
            <if test="status != null and status != ''">
                AND o.status = #{status}
            </if>
        </where>
        order by o.order_id desc
    </select>

    <insert id="insertStadUnifiedOrder" parameterType="com.ruoyi.mine.domain.MineStadUnifiedOrder" useGeneratedKeys="true" keyProperty="orderId">
        insert into stad_unified_order
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="orderNo != null and orderNo != ''">order_no,</if>
            <if test="orderType != null and orderType != ''">order_type,</if>
            <if test="userId != null">user_id,</if>
            <if test="vehicleId != null">vehicle_id,</if>
            <if test="merchantId != null">merchant_id,</if>
            <if test="contactName != null">contact_name,</if>
            <if test="contactPhone != null">contact_phone,</if>
            <if test="addressId != null">address_id,</if>
            <if test="vehiclePrice != null">vehicle_price,</if>
            <if test="totalAmount != null">total_amount,</if>
            <if test="paidAmount != null">paid_amount,</if>
            <if test="paymentMethod != null">payment_method,</if>
            <if test="insuranceInfo != null">insurance_info,</if>
            <if test="expectDate != null">expect_date,</if>
            <if test="expectTimeSlot != null">expect_time_slot,</if>
            <if test="oldVehicleId != null">old_vehicle_id,</if>
            <if test="oldValuation != null">old_valuation,</if>
            <if test="status != null">status,</if>
            <if test="createBy != null">create_by,</if>
            create_time
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="orderNo != null and orderNo != ''">#{orderNo},</if>
            <if test="orderType != null and orderType != ''">#{orderType},</if>
            <if test="userId != null">#{userId},</if>
            <if test="vehicleId != null">#{vehicleId},</if>
            <if test="merchantId != null">#{merchantId},</if>
            <if test="contactName != null">#{contactName},</if>
            <if test="contactPhone != null">#{contactPhone},</if>
            <if test="addressId != null">#{addressId},</if>
            <if test="vehiclePrice != null">#{vehiclePrice},</if>
            <if test="totalAmount != null">#{totalAmount},</if>
            <if test="paidAmount != null">#{paidAmount},</if>
            <if test="paymentMethod != null">#{paymentMethod},</if>
            <if test="insuranceInfo != null">#{insuranceInfo},</if>
            <if test="expectDate != null">#{expectDate},</if>
            <if test="expectTimeSlot != null">#{expectTimeSlot},</if>
            <if test="oldVehicleId != null">#{oldVehicleId},</if>
            <if test="oldValuation != null">#{oldValuation},</if>
            <if test="status != null">#{status},</if>
            <if test="createBy != null">#{createBy},</if>
            sysdate()
        </trim>
    </insert>

    <update id="updateStadUnifiedOrder" parameterType="com.ruoyi.mine.domain.MineStadUnifiedOrder">
        update stad_unified_order
        <set>
            <if test="orderNo != null and orderNo != ''">order_no = #{orderNo},</if>
            <if test="orderType != null and orderType != ''">order_type = #{orderType},</if>
            <if test="userId != null">user_id = #{userId},</if>
            <if test="vehicleId != null">vehicle_id = #{vehicleId},</if>
            <if test="merchantId != null">merchant_id = #{merchantId},</if>
            <if test="contactName != null">contact_name = #{contactName},</if>
            <if test="contactPhone != null">contact_phone = #{contactPhone},</if>
            <if test="addressId != null">address_id = #{addressId},</if>
            <if test="vehiclePrice != null">vehicle_price = #{vehiclePrice},</if>
            <if test="totalAmount != null">total_amount = #{totalAmount},</if>
            <if test="paidAmount != null">paid_amount = #{paidAmount},</if>
            <if test="paymentMethod != null">payment_method = #{paymentMethod},</if>
            <if test="insuranceInfo != null">insurance_info = #{insuranceInfo},</if>
            <if test="expectDate != null">expect_date = #{expectDate},</if>
            <if test="expectTimeSlot != null">expect_time_slot = #{expectTimeSlot},</if>
            <if test="oldVehicleId != null">old_vehicle_id = #{oldVehicleId},</if>
            <if test="oldValuation != null">old_valuation = #{oldValuation},</if>
            <if test="newOrderId != null">new_order_id = #{newOrderId},</if>
            <if test="status != null">status = #{status},</if>
            <if test="cancelReason != null">cancel_reason = #{cancelReason},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            update_time = sysdate()
        </set>
        where order_id = #{orderId}
    </update>

    <delete id="deleteStadUnifiedOrderById" parameterType="Long">
        delete from stad_unified_order where order_id = #{orderId}
    </delete>

    <delete id="deleteStadUnifiedOrderByIds" parameterType="Long">
        delete from stad_unified_order where order_id in
        <foreach item="orderId" collection="array" open="(" separator="," close=")">
            #{orderId}
        </foreach>
    </delete>

</mapper>
