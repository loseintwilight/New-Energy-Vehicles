<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.business.mapper.StadChargingRateMapper">

    <resultMap type="StadChargingRate" id="StadChargingRateResult">
        <result property="rateId"       column="rate_id"        />
        <result property="stationId"    column="station_id"     />
        <result property="rateName"     column="rate_name"      />
        <result property="pileType"     column="pile_type"      />
        <result property="isActive"     column="is_active"      />
        <result property="effectiveFrom" column="effective_from" />
        <result property="effectiveTo"  column="effective_to"   />
        <result property="description"  column="description"    />
        <result property="sortOrder"    column="sort_order"     />
        <result property="createTime"   column="create_time"    />
    </resultMap>

    <sql id="selectChargingRateVo">
        select rate_id, station_id, rate_name, pile_type, is_active, effective_from, effective_to, description, sort_order, create_time
        from stad_charging_rate
    </sql>

    <select id="selectStadChargingRateById" parameterType="Long" resultMap="StadChargingRateResult">
        <include refid="selectChargingRateVo"/> where rate_id = #{rateId}
    </select>

    <select id="selectStadChargingRateByStationId" parameterType="Long" resultMap="StadChargingRateResult">
        <include refid="selectChargingRateVo"/> where station_id = #{stationId} order by sort_order asc
    </select>

    <select id="selectStadChargingRateList" parameterType="StadChargingRate" resultMap="StadChargingRateResult">
        <include refid="selectChargingRateVo"/>
        <where>
            <if test="stationId != null">AND station_id = #{stationId}</if>
            <if test="pileType != null and pileType != ''">AND pile_type = #{pileType}</if>
            <if test="isActive != null">AND is_active = #{isActive}</if>
        </where>
        order by sort_order asc
    </select>

    <insert id="insertStadChargingRate" parameterType="StadChargingRate" useGeneratedKeys="true" keyProperty="rateId">
        insert into stad_charging_rate
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="stationId != null">station_id,</if>
            <if test="rateName != null">rate_name,</if>
            <if test="pileType != null">pile_type,</if>
            <if test="isActive != null">is_active,</if>
            <if test="effectiveFrom != null">effective_from,</if>
            <if test="effectiveTo != null">effective_to,</if>
            <if test="description != null">description,</if>
            <if test="sortOrder != null">sort_order,</if>
            create_time
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="stationId != null">#{stationId},</if>
            <if test="rateName != null">#{rateName},</if>
            <if test="pileType != null">#{pileType},</if>
            <if test="isActive != null">#{isActive},</if>
            <if test="effectiveFrom != null">#{effectiveFrom},</if>
            <if test="effectiveTo != null">#{effectiveTo},</if>
            <if test="description != null">#{description},</if>
            <if test="sortOrder != null">#{sortOrder},</if>
            sysdate()
        </trim>
    </insert>

    <update id="updateStadChargingRate" parameterType="StadChargingRate">
        update stad_charging_rate
        <set>
            <if test="stationId != null">station_id = #{stationId},</if>
            <if test="rateName != null">rate_name = #{rateName},</if>
            <if test="pileType != null">pile_type = #{pileType},</if>
            <if test="isActive != null">is_active = #{isActive},</if>
            <if test="effectiveFrom != null">effective_from = #{effectiveFrom},</if>
            <if test="effectiveTo != null">effective_to = #{effectiveTo},</if>
            <if test="description != null">description = #{description},</if>
            <if test="sortOrder != null">sort_order = #{sortOrder},</if>
        </set>
        where rate_id = #{rateId}
    </update>

    <delete id="deleteStadChargingRateById" parameterType="Long">
        delete from stad_charging_rate where rate_id = #{rateId}
    </delete>

    <delete id="deleteStadChargingRateByIds" parameterType="Long">
        delete from stad_charging_rate where rate_id in
        <foreach item="rateId" collection="array" open="(" separator="," close=")">#{rateId}</foreach>
    </delete>

</mapper>